APP_NAME=B2B Product Intelligence Assistant API
APP_VERSION=0.15.0
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=b2b_assistant
POSTGRES_USER=b2b_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_CONNECT_TIMEOUT=5
DATABASE_ECHO=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.0
OLLAMA_MAX_ATTEMPTS=2

# Optional local fallback model, used only if the primary model above is unreachable,
# not installed, times out, or errors. Same loopback Ollama server -- never a cloud
# endpoint. Pull it with `ollama pull llama3.2:3b`, or set OLLAMA_FALLBACK_ENABLED=false
# / leave OLLAMA_FALLBACK_MODEL blank to disable.
OLLAMA_FALLBACK_MODEL=llama3.2:3b
OLLAMA_FALLBACK_ENABLED=true

DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_NATIVE_TEXT_MIN_CHARACTERS=24
DOCUMENT_OCR_LANGUAGE=en

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=b2b_document_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIRECTORY=./data/embedding_models
RAG_CHUNK_SIZE_CHARACTERS=900
RAG_CHUNK_OVERLAP_CHARACTERS=160
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.25
RAG_MAX_EVIDENCE_CHARACTERS=6500

UPLOAD_DIRECTORY=./uploads
LOG_DIRECTORY=./logs
SQL_READ_MAX_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=3000
