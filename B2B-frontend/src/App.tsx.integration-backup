function TransitionGate({ username, onDone }: { username: string; onDone: () => void }) {
  // Keep TransitionScreen as the single ~1.5–2.5s authentication experience.
  // After completion, transition directly into the main workspace.
  return (
    <TransitionScreen
      username={username.split(' ')[0] || username}
      durationMs={2000}
      onComplete={onDone}
    />
  );
}








function App() {


  const [loginGate, setLoginGate] = useState<{ userName: string } | null>(null);

  const beginLoginGate = (nextUser: LocalUser) => {
    setLoginGate({ userName: nextUser.name || 'User' });
  };

  const [user, setUser] = useState<LocalUser | null>(() => getStoredUser());
  const [page, setPage] = useState<Page>('dashboard');
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [toasts, setToasts] = useState<Toast[]>([]);

  const pushToast = (message: string, type: Toast['type'] = 'info') => {
    const id = Date.now() + Math.floor(Math.random() * 10_000);
    setToasts((current) => [...current, { id, message, type }]);
    window.setTimeout(() => setToasts((current) => current.filter((toast) => toast.id !== id)), 3800);
  };

  const login = (nextUser: LocalUser) => {
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(nextUser));
    beginLoginGate(nextUser);
    window.setTimeout(() => {
      setUser(nextUser);
      setPage('dashboard');
      pushToast(`Workspace ready. Welcome, ${nextUser.name.split(' ')[0] || 'there'}.`, 'success');
      setLoginGate(null);
    }, 1400);
  };

  const logout = () => {
    sessionStorage.removeItem(STORAGE_KEY);
    sessionStorage.removeItem(SESSION_KEY);
    setUser(null);
    setPage('dashboard');
  };

  if (!user) return <LoginView onEnter={login} />;

  if (loginGate) {
    return (
      <div className="app-shell app-shell--gate">
        <TransitionGate
          username={loginGate.userName}
          onDone={() => {
            // After transition, show the existing gate for a split second to preserve existing UX.
            // LoadingGate already includes animated progress.
            setLoginGate(null);
          }}
        />
      </div>
    );
  }
  return (
    <div className="app-shell">
      <BusinessBackground />


      <Sidebar user={user} page={page} onPage={setPage} open={sidebarOpen} onToggle={() => setSidebarOpen((value) => !value)} onLogout={logout} />
      <main className="main-area">
        <Topbar user={user} page={page} sidebarOpen={sidebarOpen} onMenu={() => setSidebarOpen((value) => !value)} onPage={setPage} />
        <section className="page-stage">
          <PageTransition key={page}>
            <PageRenderer page={page} user={user} onPage={setPage} toast={pushToast} />
          </PageTransition>
        </section>

      </main>
      <ToastStack toasts={toasts} />
    </div>
  );
}

