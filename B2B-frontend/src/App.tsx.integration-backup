function Assistant({ user, toast }: { user: LocalUser; toast: (message: string, type?: Toast['type']) => void }) {
  const [workspace, setWorkspace] = useState<'ask' | 'knowledge' | 'actions' | 'sessions' | 'evidence'>('ask');
  const [actionView, setActionView] = useState<'queue' | 'duplicates'>('queue');
  const [messages, setMessages] = useState<{ id: string; from: 'user' | 'assistant'; text: string; response?: ApiEnvelope<any> }[]>([]);
  const [question, setQuestion] = useState('');
  const [loading, setLoading] = useState(false);
  const [sessionId, setSessionId] = useState<string | null>(() => sessionStorage.getItem(SESSION_KEY));
  const [selectedResponse, setSelectedResponse] = useState<ApiEnvelope<any> | null>(null);
  const [confirming, setConfirming] = useState<ApiEnvelope<any> | null>(null);

  const submit = async (event?: FormEvent, quick?: string) => {
    event?.preventDefault();
    const prompt = (quick || question).trim();
    if (!prompt || loading) return;
    setQuestion(''); setLoading(true); setMessages((list) => [...list, { id: `user-${Date.now()}`, from: 'user', text: prompt }]);
    try {
      const response = await api.post('/api/query', user.role, { question: prompt, session_id: sessionId, top_k: 4 });
      const nextSession = asRecord(response.data).session?.session_id || response.session_id || sessionId;
      if (nextSession) { sessionStorage.setItem(SESSION_KEY, String(nextSession)); setSessionId(String(nextSession)); }
      setMessages((list) => [...list, { id: response.request_id || `assistant-${Date.now()}`, from: 'assistant', text: response.answer || 'No answer returned.', response }]);
      setSelectedResponse(response);
    } catch (error) { const message = error instanceof Error ? error.message : 'The assistant request failed.'; setMessages((list) => [...list, { id: `error-${Date.now()}`, from: 'assistant', text: message }]); toast(message, 'error'); }
    finally { setLoading(false); }
  };

  const mutatePending = async (response: ApiEnvelope<any>, action: 'confirm' | 'cancel') => {
    const id = response.pending_action_id;
    if (!id || !sessionId) return;
    try {
      const result = await api.post(`/api/crud/actions/${id}/${action}`, user.role, { session_id: sessionId });
      setMessages((list) => [...list, { id: result.request_id || `${action}-${Date.now()}`, from: 'assistant', text: result.answer || `Action ${action}ed.`, response: result }]);
      toast(result.answer || `Action ${action}ed.`, action === 'confirm' ? 'success' : 'info');
      setConfirming(null);
    } catch (error) { toast(error instanceof Error ? error.message : 'The stored action could not be updated.', 'error'); }
  };

  return <div className="assistant-page page-enter">
    <div className="assistant-toolbar"><div><div className="eyebrow compact"><i /> CONSOLIDATED INTELLIGENCE WORKSPACE</div><h2>Ask, retrieve, review, and act.</h2><p>Natural-language querying, document RAG, confirmation-gated writes, duplicate checks, sessions, and pipeline evidence now live together.</p></div><div className="assistant-tags"><StatusBadge status="Local AI" /><StatusBadge status="Source-backed" /><StatusBadge status="Safe actions" /></div></div>
    <div className="tab-row workspace-tabs">
      <button className={workspace === 'ask' ? 'selected' : ''} onClick={() => setWorkspace('ask')}><Bot size={14} /> Ask</button>
      <button className={workspace === 'knowledge' ? 'selected' : ''} onClick={() => setWorkspace('knowledge')}><FileSearch size={14} /> Document search</button>
      <button className={workspace === 'actions' ? 'selected' : ''} onClick={() => setWorkspace('actions')}><ListTree size={14} /> Safe actions</button>
      <button className={workspace === 'sessions' ? 'selected' : ''} onClick={() => setWorkspace('sessions')}><History size={14} /> Sessions</button>
      <button className={workspace === 'evidence' ? 'selected' : ''} onClick={() => setWorkspace('evidence')}><Network size={14} /> Pipeline evidence</button>
    </div>

    {workspace === 'ask' && <>
      <div className="assistant-layout">
        <section className="chat-panel surface-card">
          <div className="chat-scroll">{messages.length === 0 && <div className="assistant-empty"><span className="assistant-avatar"><Sparkles size={22} /></span><h3>What would you like to understand?</h3><p>Ask about current business records, uploaded documents, or a verified combination of both.</p><div className="prompt-chips">{['Show workers from Bangalore','What warranty is mentioned for TextileBot X?','Which vendor offers textile automation products under 5 lakh according to the brochure?','Add a new employee safely'].map((item) => <button key={item} onClick={() => void submit(undefined, item)}>{item}</button>)}</div></div>}
            {messages.map((message) => <ChatMessage key={message.id} message={message} onInspect={() => message.response && setSelectedResponse(message.response)} onConfirm={() => message.response && setConfirming(message.response)} onCancel={() => message.response && void mutatePending(message.response, 'cancel')} />)}
            {loading && <div className="assistant-message loading-message"><span className="assistant-avatar"><Bot size={17} /></span><div><div className="typing"><i/><i/><i/></div><small>Preparing grounded response through local services…</small></div></div>}
          </div>
          <form className="composer" onSubmit={(event) => void submit(event)}><textarea value={question} onChange={(event) => setQuestion(event.target.value)} placeholder="Ask about your business data or documents…" rows={1} onKeyDown={(event) => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); void submit(); } }} /><button className="send-button" disabled={!question.trim() || loading} aria-label="Send message"><Send size={18} /></button><span>Enter to send · Shift + Enter for a new line</span></form>
        </section>
        <EvidencePanel response={selectedResponse} />
      </div>
      {confirming && <ConfirmModal response={confirming} onClose={() => setConfirming(null)} onConfirm={() => void mutatePending(confirming, 'confirm')} />}
    </>}

    {workspace === 'knowledge' && <KnowledgeWorkspace user={user} toast={toast} />}
    {workspace === 'actions' && <div className="embedded-workspace"><div className="tab-row sub-tabs"><button className={actionView === 'queue' ? 'selected' : ''} onClick={() => setActionView('queue')}>CRUD proposals</button><button className={actionView === 'duplicates' ? 'selected' : ''} onClick={() => setActionView('duplicates')}>Duplicate-aware bulk insert</button></div>{actionView === 'queue' ? <CrudQueuePage user={user} toast={toast} /> : <DuplicateCenterPage user={user} toast={toast} />}</div>}
    {workspace === 'sessions' && <div className="embedded-workspace"><SessionCenterPage user={user} toast={toast} /></div>}
    {workspace === 'evidence' && <div className="embedded-workspace"><PipelineConsolePage user={user} toast={toast} /></div>}
  </div>;
}

function ChatMessage({ message, onInspect, onConfirm, onCancel }: { message: { id: string; from: 'user' | 'assistant'; text: string; response?: ApiEnvelope<any> }; onInspect: () => void; onConfirm: () => void; onCancel: () => void }) {
  const response = message.response;
  if (message.from === 'user') return <div className="message-row user-row"><div className="user-bubble">{message.text}</div><span className="user-mini-avatar">U</span></div>;
  const data = asRecord(response?.data);
